# Example Nginx Configuration for Tsuru RSS Feed Manager
# Save this to /etc/nginx/sites-available/tsuru
# Then: sudo ln -s /etc/nginx/sites-available/tsuru /etc/nginx/sites-enabled/

# =============================================================================
# OPTION 1: ROOT PATH DEPLOYMENT
# Deploy at https://example.com/
# =============================================================================

# server {
#     listen 80;
#     server_name example.com;
#     
#     location / {
#         proxy_pass http://localhost:8000;
#         proxy_set_header Host $host;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#     }
# }

# =============================================================================
# OPTION 2: SUB-PATH DEPLOYMENT
# Deploy at https://example.com/manage/
# Requires: ROOT_PATH=/manage in docker-compose.yml
# =============================================================================

server {
    listen 80;
    server_name example.com;

    # Example: Other service at root
    # location / {
    #     proxy_pass http://localhost:3000;
    #     # ... proxy settings
    # }

    # Example: Miniflux at /miniflux
    # location /miniflux/ {
    #     proxy_pass http://localhost:8080/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    # Tsuru at /manage
    location /manage/ {
        proxy_pass http://localhost:8000/;  # Trailing slash is REQUIRED
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Optional: WebSocket support (for future features)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Optional: Increase timeouts for long TTS processing
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
    }
}

