# Copy this file to .env and update with your values

# Secret key for CSRF token generation (required for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# Google Gemini API key for TTS functionality
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Port to run the application on
PORT=8000

# Directory where database will be stored
DATA_DIR=/app/data

# Root path for nginx sub-path deployments
# Leave empty for root path deployment (e.g., https://example.com/)
# Set to /manage for sub-path deployment (e.g., https://example.com/manage/)
ROOT_PATH=
